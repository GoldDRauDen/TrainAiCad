TRAINAICAD_REPO_ROOT=
TRAINAICAD_MCP_PORT=8787
TRAINAICAD_MCP_HOST=127.0.0.1
TRAINAICAD_MCP_AUTH_TOKEN=
TRAINAICAD_MCP_DATA=
TRAINAICAD_MAX_SOURCE_BYTES=26214400
TRAINAICAD_ALLOW_PRIVATE_URL=
TRAINAICAD_SOURCE_COMMIT=
TRAINAICAD_PUBLIC_URL=
TRAINAICAD_ARTIFACT_SECRET=
TRAINAICAD_REQUIRE_DURABLE=0
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TRAINAICAD_STORAGE_BUCKET=trainaicad-private
TRAINAICAD_STORAGE_NAMESPACE=research-owner
JEV_MODE=disabled
TYPESAFE_API_KEY=

# Cloud: auth0. Local development: local. Bearer is developer testing only.
TRAINAICAD_AUTH_MODE=local

# Auth0 public MCP authentication.
# Example issuer: https://trainaicad.us.auth0.com/
TRAINAICAD_AUTH0_ISSUER=
# Must equal the canonical MCP resource, e.g. https://trainaicad.onrender.com/mcp
TRAINAICAD_AUTH0_AUDIENCE=
# Exact Auth0 user subject allowed to use this single-owner MCP, e.g. auth0|...
TRAINAICAD_AUTH0_OWNER_SUB=

# Legacy Supabase OAuth mode only. Supabase remains required for durable storage above.
SUPABASE_PUBLISHABLE_KEY=
TRAINAICAD_OWNER_ID=
TRAINAICAD_OAUTH_CLIENT_ID=
# Exact callback copied from ChatGPT connector management; comma-separated if needed.
TRAINAICAD_OAUTH_REDIRECT_URIS=
