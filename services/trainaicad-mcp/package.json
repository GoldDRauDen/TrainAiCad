{
  "name": "@trainaicad/mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Experimental TrainAiCad MCP V0.3 full CAD runtime",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx src/http.ts",
    "doctor": "node scripts/doctor.mjs",
    "check": "tsc --noEmit && npm run test:unit",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:integration": "node scripts/run_e2e.mjs",
    "test:gate": "node scripts/run_gates.mjs",
    "test:e2e": "node scripts/run_e2e.mjs && node scripts/check_source_acceptance.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0"
  }
}
