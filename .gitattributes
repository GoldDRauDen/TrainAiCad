# Rule files are measured in exact UTF-8 bytes (load budgets, hashes): keep LF on every platform.
* text=auto eol=lf
# DXF is stored byte-for-byte; the template is committed with CRLF.
*.dxf -text
*.png binary
*.pdf binary
# Luan App: Windows batch needs CRLF; fonts are binary.
luan_app/*.cmd text eol=crlf
*.woff2 binary
